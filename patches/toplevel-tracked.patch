--- /dev/null
+++ b/tools/bench_h3_ops.py
@@ -0,0 +1,350 @@
+#!/usr/bin/env python3
+"""Operator-level correctness and performance harness for the MiniMax-H3
+NineToothed kernels of this tree (attention, q/k norm + RoPE, RoPE, the RoPE
+table, RMSNorm, RMSNorm/AdaLN, gated residual, gated residual + RMSNorm/AdaLN,
+SwiGLU).
+
+For every operator it builds the kernel with NineToothed, runs the eager
+PyTorch composition that the reference pipeline performs as the baseline, and
+reports whether the kernel output is bitwise identical to it (plus the largest
+absolute difference when it is not) and how long each takes. The reference
+composition keeps the per-step BF16 rounding of the Diffusers implementation,
+which is what these kernels reproduce.
+
+It needs only PyTorch and NineToothed (no InfiniCore build), so the same
+command runs on any Hygon architecture:
+
+    python tools/bench_h3_ops.py --seq 8192 --heads 14 --json ops_z100.json
+
+Options worth knowing:
+    --dtype bf16|fp16   kernel and tensor dtype (gfx906/Z100 has no native
+                        BF16 arithmetic, so fp16 is the fallback to compare)
+    --ops a,b,c         run only these operators
+    --repeats N         timed iterations (after 3 warmup iterations)
+Never used by generation; diagnostics only.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+
+import torch
+
+sys.path[:0] = [str(Path(__file__).resolve().parents[1] / "ninetoothed/src"),
+                str(Path(__file__).resolve().parent)]
+
+import ninetoothed  # noqa: E402
+
+from h3_attention import make_attention  # noqa: E402
+from h3_pointwise import (  # noqa: E402
+    make_gated_residual,
+    make_gated_residual_rms_modulate,
+    make_qk_norm_rope,
+    make_rms,
+    make_rms_modulate,
+    make_rope,
+    make_rope_cache,
+    make_swiglu,
+)
+
+DTYPES = {"bf16": (torch.bfloat16, ninetoothed.bfloat16),
+          "fp16": (torch.float16, ninetoothed.float16)}
+HIDDEN = 5376
+FFN = 14336
+HEAD_DIM = 128
+
+
+def timed(fn, repeats: int) -> float:
+    """Milliseconds per call, after three warmup calls."""
+    for _ in range(3):
+        fn()
+    torch.cuda.synchronize()
+    start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    start.record()
+    for _ in range(repeats):
+        fn()
+    end.record()
+    torch.cuda.synchronize()
+    return start.elapsed_time(end) / repeats
+
+
+def difference(out: torch.Tensor, reference: torch.Tensor) -> tuple[bool, float]:
+    same = torch.equal(out, reference)
+    if same:
+        return True, 0.0
+    return False, (out.float() - reference.float()).abs().max().item()
+
+
+def rms_norm_reference(x, weight, eps):
+    """RMSNorm with each intermediate rounded to the tensor dtype, as the
+    Diffusers reference does in BF16."""
+    squared = (x.float() * x.float()).to(x.dtype)
+    mean = (squared.float().sum(-1, keepdim=True) / x.shape[-1]).to(x.dtype)
+    variance = (mean.float() + torch.tensor(eps, dtype=torch.float32, device=x.device)).to(x.dtype)
+    reciprocal = torch.rsqrt(variance.float()).to(x.dtype)
+    return ((x.float() * reciprocal.float()).to(x.dtype).float() * weight.float()).to(x.dtype)
+
+
+def modulate_reference(normalized, scale, shift):
+    factor = (scale.float() + 1.0).to(scale.dtype)
+    return ((normalized.float() * factor.float()).to(normalized.dtype).float() + shift.float()).to(normalized.dtype)
+
+
+def rope_reference(x, cos, sin):
+    """3-axis NeoX RoPE on the first 96 of 128 channels, BF16 rounding per step."""
+    a, b, passthrough = x[..., :48], x[..., 48:96], x[..., 96:]
+    c = cos.float().unsqueeze(-2)
+    s = sin.float().unsqueeze(-2)
+    ac = (a.float() * c).to(x.dtype)
+    bs = (-b.float() * s).to(x.dtype)
+    bc = (b.float() * c).to(x.dtype)
+    a_s = (a.float() * s).to(x.dtype)
+    return torch.cat([(ac.float() + bs.float()).to(x.dtype),
+                      (bc.float() + a_s.float()).to(x.dtype), passthrough], dim=-1)
+
+
+def rotary_cache_reference(position_ids, rope_freq_dim=16, rope_theta=10000.0, dtype=torch.bfloat16):
+    inverse = 1.0 / (rope_theta ** (torch.arange(0, 2 * rope_freq_dim, 2, dtype=torch.float32,
+                                                 device=position_ids.device) / (2 * rope_freq_dim)))
+    frequencies = (position_ids.float().unsqueeze(-1) * inverse.view(1, 1, -1)).flatten(1)
+    return torch.cat((frequencies.cos(), frequencies.sin()), dim=-1).to(dtype)
+
+
+def op_attention(cfg):
+    heads, seq, dtype = cfg.heads, cfg.seq, cfg.torch_dtype
+    scale = HEAD_DIM ** -0.5
+    q, k, v = (torch.randn(1, heads, seq, HEAD_DIM, device=cfg.device, dtype=dtype) for _ in range(3))
+    kernel = make_attention(dtype=cfg.nt_dtype, **cfg.attention_config)
+    out = torch.empty_like(q)
+    baseline = lambda: torch.nn.functional.scaled_dot_product_attention(q, k, v, scale=scale)  # noqa: E731
+    reference = baseline()
+    kernel(q, k, v, scale, out)
+    flops = 4 * seq * seq * HEAD_DIM * heads
+    return out, reference, lambda: kernel(q, k, v, scale, out), baseline, flops
+
+
+def op_qk_norm_rope(cfg):
+    """Per-head RMSNorm + 3-axis RoPE written into a packed send buffer, on a
+    strided view of a fused QKV projection (the sequence-parallel layout)."""
+    tokens, dtype = cfg.seq, cfg.torch_dtype
+    ranks, heads = 1, cfg.heads
+    projected = torch.randn(tokens, 3, ranks * heads, HEAD_DIM, device=cfg.device, dtype=dtype)
+    source = projected[:, 0]
+    x = source.as_strided((tokens, ranks, heads, HEAD_DIM),
+                          (source.stride(0), heads * source.stride(1), source.stride(1), 1))
+    weight = (torch.rand(HEAD_DIM, device=cfg.device) + 0.5).to(dtype)
+    cos = torch.rand(tokens, 48, device=cfg.device).to(dtype)
+    sin = torch.rand(tokens, 48, device=cfg.device).to(dtype)
+    send = torch.empty(ranks, tokens, heads, HEAD_DIM, device=cfg.device, dtype=dtype)
+    out = send.permute(1, 0, 2, 3)
+    kernel = make_qk_norm_rope(dtype=cfg.nt_dtype)
+
+    def baseline():
+        normalized = rms_norm_reference(x, weight, 1e-6)
+        rotated = rope_reference(normalized, cos.unsqueeze(1).expand(-1, ranks, -1),
+                                 sin.unsqueeze(1).expand(-1, ranks, -1))
+        return rotated.permute(1, 0, 2, 3).contiguous()
+
+    reference = baseline()
+    kernel(x, weight, 1e-6, cos, sin, out)
+    return send, reference, lambda: kernel(x, weight, 1e-6, cos, sin, out), baseline, None
+
+
+def op_rope(cfg):
+    tokens, dtype = cfg.seq, cfg.torch_dtype
+    x = torch.randn(1, tokens, HEAD_DIM, device=cfg.device, dtype=dtype)
+    cos = torch.rand(tokens, 48, device=cfg.device).to(dtype)
+    sin = torch.rand(tokens, 48, device=cfg.device).to(dtype)
+    kernel = make_rope(dtype=cfg.nt_dtype)
+    out = torch.empty_like(x)
+    baseline = lambda: rope_reference(x, cos.unsqueeze(0), sin.unsqueeze(0))  # noqa: E731
+    reference = baseline()
+    kernel(x, cos, sin, out)
+    return out, reference, lambda: kernel(x, cos, sin, out), baseline, None
+
+
+def op_rope_cache(cfg):
+    tokens = cfg.seq
+    positions = torch.randint(0, 4096, (tokens, 3), device=cfg.device).double()
+    exponent = torch.tensor([2 * k / 32 for k in range(16)], dtype=torch.float32, device=cfg.device)
+    power = torch.full_like(exponent, 10000.0) ** exponent
+    kernel = make_rope_cache(dtype=cfg.nt_dtype)
+    out = torch.empty(tokens, 96, device=cfg.device, dtype=cfg.torch_dtype)
+    baseline = lambda: rotary_cache_reference(positions, dtype=cfg.torch_dtype)  # noqa: E731
+    reference = baseline()
+    kernel(positions, power, out[:, :48], out[:, 48:])
+    return out, reference, lambda: kernel(positions, power, out[:, :48], out[:, 48:]), baseline, None
+
+
+def op_rms(cfg):
+    tokens, dtype = cfg.seq, cfg.torch_dtype
+    x = torch.randn(1, tokens, HIDDEN, device=cfg.device, dtype=dtype) * 8
+    weight = torch.randn(HIDDEN, device=cfg.device, dtype=dtype)
+    kernel = make_rms(width=HIDDEN, dtype=cfg.nt_dtype)
+    out = torch.empty_like(x)
+    baseline = lambda: rms_norm_reference(x, weight, 1e-6)  # noqa: E731
+    reference = baseline()
+    kernel(x, weight, 1e-6, out)
+    return out, reference, lambda: kernel(x, weight, 1e-6, out), baseline, None
+
+
+def op_rms_modulate(cfg):
+    tokens, dtype = cfg.seq, cfg.torch_dtype
+    x = torch.randn(1, tokens, HIDDEN, device=cfg.device, dtype=dtype) * 8
+    weight = torch.randn(HIDDEN, device=cfg.device, dtype=dtype)
+    scale = (torch.randn(1, tokens, HIDDEN, device=cfg.device, dtype=dtype) * 0.5)
+    shift = (torch.randn(1, tokens, HIDDEN, device=cfg.device, dtype=dtype) * 0.5)
+    kernel = make_rms_modulate(dtype=cfg.nt_dtype)
+    out = torch.empty_like(x)
+    baseline = lambda: modulate_reference(rms_norm_reference(x, weight, 1e-6), scale, shift)  # noqa: E731
+    reference = baseline()
+    kernel(x, weight, 1e-6, scale, shift, out)
+    return out, reference, lambda: kernel(x, weight, 1e-6, scale, shift, out), baseline, None
+
+
+def op_gated_residual(cfg):
+    tokens, dtype = cfg.seq, cfg.torch_dtype
+    x = torch.randn(1, tokens, HIDDEN, device=cfg.device, dtype=dtype) * 8
+    y = torch.randn(1, tokens, HIDDEN, device=cfg.device, dtype=dtype)
+    gate = torch.randn(1, tokens, HIDDEN, device=cfg.device, dtype=dtype) * 0.5
+    kernel = make_gated_residual(dtype=cfg.nt_dtype)
+    out = torch.empty_like(x)
+    baseline = lambda: torch.add(x, torch.mul(gate, y))  # noqa: E731
+    reference = baseline()
+    kernel(x, gate, y, out)
+    return out, reference, lambda: kernel(x, gate, y, out), baseline, None
+
+
+def op_gated_residual_rms_modulate(cfg):
+    tokens, dtype = cfg.seq, cfg.torch_dtype
+    x = torch.randn(1, tokens, HIDDEN, device=cfg.device, dtype=dtype) * 8
+    y = torch.randn(1, tokens, HIDDEN, device=cfg.device, dtype=dtype)
+    gate = torch.randn(1, tokens, HIDDEN, device=cfg.device, dtype=dtype) * 0.5
+    weight = torch.randn(HIDDEN, device=cfg.device, dtype=dtype)
+    scale = torch.randn(1, tokens, HIDDEN, device=cfg.device, dtype=dtype) * 0.5
+    shift = torch.randn(1, tokens, HIDDEN, device=cfg.device, dtype=dtype) * 0.5
+    kernel = make_gated_residual_rms_modulate(dtype=cfg.nt_dtype)
+    residual, out = torch.empty_like(x), torch.empty_like(x)
+
+    def baseline():
+        added = torch.add(x, torch.mul(gate, y))
+        return added, modulate_reference(rms_norm_reference(added, weight, 1e-6), scale, shift)
+
+    reference_residual, reference_out = baseline()
+    kernel(x, gate, y, weight, 1e-6, scale, shift, residual, out)
+    same_residual, delta_residual = difference(residual, reference_residual)
+    if not same_residual:
+        print(f"  (residual differs, max |diff| {delta_residual:.3g})")
+    return out, reference_out, lambda: kernel(x, gate, y, weight, 1e-6, scale, shift, residual, out), baseline, None
+
+
+def op_swiglu(cfg):
+    tokens, dtype = cfg.seq, cfg.torch_dtype
+    packed = torch.randn(1, tokens, 2 * FFN, device=cfg.device, dtype=dtype) * 2
+    up, gate = packed[..., :FFN], packed[..., FFN:]
+    kernel = make_swiglu(dtype=cfg.nt_dtype)
+    out = torch.empty(1, tokens, FFN, device=cfg.device, dtype=dtype)
+
+    def baseline():
+        value = gate.float()
+        activated = (value / (1.0 + torch.exp(-value))).to(dtype)
+        return up * activated
+
+    reference = baseline()
+    kernel(up, gate, out)
+    return out, reference, lambda: kernel(up, gate, out), baseline, None
+
+
+OPERATORS = {
+    "attention": op_attention,
+    "qk_norm_rope": op_qk_norm_rope,
+    "rope": op_rope,
+    "rope_cache": op_rope_cache,
+    "rms": op_rms,
+    "rms_modulate": op_rms_modulate,
+    "gated_residual": op_gated_residual,
+    "gated_residual_rms_modulate": op_gated_residual_rms_modulate,
+    "swiglu": op_swiglu,
+}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--seq", type=int, default=8192, help="tokens (default 8192)")
+    parser.add_argument("--heads", type=int, default=14, help="attention heads per device")
+    parser.add_argument("--dtype", choices=sorted(DTYPES), default="bf16")
+    parser.add_argument("--device", default="cuda:0")
+    parser.add_argument("--repeats", type=int, default=20)
+    parser.add_argument("--ops", help="comma-separated subset of " + ",".join(OPERATORS))
+    parser.add_argument("--attention-config", default="{}",
+                        help='JSON overrides, e.g. {"block_m": 128, "block_n": 32, "num_warps": 4}')
+    parser.add_argument("--json", type=Path, help="write the results as JSON")
+    parser.add_argument("--seed", type=int, default=0)
+    args = parser.parse_args()
+
+    if not torch.cuda.is_available():
+        print("no accelerator visible")
+        return 1
+    torch.manual_seed(args.seed)
+    torch_dtype, nt_dtype = DTYPES[args.dtype]
+    attention_config = {"block_m": 128, "block_n": 32, "num_warps": 4, "num_stages": 1}
+    attention_config.update(json.loads(args.attention_config))
+
+    class Config:
+        seq = args.seq
+        heads = args.heads
+        device = args.device
+        torch_dtype = None
+        nt_dtype = None
+        attention_config = None
+
+    cfg = Config()
+    cfg.torch_dtype = torch_dtype
+    cfg.nt_dtype = nt_dtype
+    cfg.attention_config = attention_config
+
+    properties = torch.cuda.get_device_properties(torch.device(args.device))
+    environment = {"device": properties.name, "arch": properties.gcnArchName,
+                   "torch": torch.__version__, "hip": getattr(torch.version, "hip", None),
+                   "dtype": args.dtype, "seq": args.seq, "heads": args.heads,
+                   "attention_config": attention_config}
+    print(json.dumps(environment), flush=True)
+    print(f"{'operator':<30} {'kernel':>10} {'eager':>10} {'speedup':>8} {'bitwise':>8}  note", flush=True)
+
+    selected = args.ops.split(",") if args.ops else list(OPERATORS)
+    results = []
+    for name in selected:
+        if name not in OPERATORS:
+            print(f"{name:<30} unknown operator")
+            continue
+        try:
+            with torch.cuda.device(args.device), torch.inference_mode():
+                out, reference, run, baseline, flops = OPERATORS[name](cfg)
+                same, delta = difference(out, reference)
+                kernel_ms = timed(run, args.repeats)
+                eager_ms = timed(baseline, args.repeats)
+        except Exception as exc:  # noqa: BLE001
+            print(f"{name:<30} failed: {type(exc).__name__}: {str(exc)[:90]}", flush=True)
+            results.append({"operator": name, "error": f"{type(exc).__name__}: {exc}"})
+            continue
+        note = "" if same else f"max |diff| {delta:.3g}"
+        if flops:
+            note = (note + " " if note else "") + f"{flops / kernel_ms / 1e9:.1f} TFLOPS"
+        print(f"{name:<30} {kernel_ms:9.3f}m {eager_ms:9.3f}m {eager_ms / kernel_ms:7.2f}x "
+              f"{str(same):>8}  {note}", flush=True)
+        results.append({"operator": name, "kernel_ms": kernel_ms, "eager_ms": eager_ms,
+                        "speedup": eager_ms / kernel_ms, "bitwise_equal": same,
+                        "max_abs_difference": delta, "flops": flops})
+    if args.json:
+        args.json.write_text(json.dumps({"environment": environment, "results": results,
+                                         "diagnostic_only": True}, indent=2) + "\n")
+        print(f"wrote {args.json}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/bench_infinicore_ops.py b/tools/bench_infinicore_ops.py
new file mode 100644
index 0000000..5c615c5
--- /dev/null
+++ b/tools/bench_infinicore_ops.py
@@ -0,0 +1,227 @@
+#!/usr/bin/env python3
+"""Baseline measurement of the MiniMax-H3 operators as InfiniCore implements
+them, against the PyTorch composition the reference pipeline performs.
+
+Unlike tools/bench_h3_ops.py (which measures this tree's NineToothed kernels
+and therefore needs a Triton backend for the architecture), this harness only
+needs a built InfiniCore with its Python extension, so it runs on any
+architecture InfiniCore supports -- including gfx906/Z100, where upstream
+Triton has no backend.
+
+For every operator it reports whether InfiniCore's result matches the PyTorch
+reference (bitwise, and the largest absolute difference otherwise) and the
+time of each, at the H3 shapes. Use it to establish the baseline an
+optimization is measured against, and to re-measure afterwards.
+
+    python tools/bench_infinicore_ops.py --tokens 8192 --json base.json
+
+Diagnostics only; never used by generation.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import torch
+
+import infinicore
+from infinicore.lib import _infinicore
+
+HIDDEN = 5376
+FFN = 14336
+HEAD_DIM = 128
+TIME_EMBED_DIM = 256
+
+
+def wrap(tensor: torch.Tensor):
+    """An InfiniCore view of a torch tensor's storage (no copy)."""
+    return infinicore.strided_from_blob(
+        tensor.data_ptr(), list(tensor.shape), list(tensor.stride()),
+        dtype=infinicore.utils.to_infinicore_dtype(tensor.dtype),
+        device=infinicore.device(tensor.device.type, tensor.device.index or 0),
+    )._underlying
+
+
+def timed(fn, repeats: int, device) -> float:
+    for _ in range(3):
+        fn()
+    torch.cuda.synchronize(device)
+    start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    start.record()
+    for _ in range(repeats):
+        fn()
+    end.record()
+    torch.cuda.synchronize(device)
+    return start.elapsed_time(end) / repeats
+
+
+def difference(out: torch.Tensor, reference: torch.Tensor):
+    if torch.equal(out, reference):
+        return True, 0.0
+    return False, (out.float() - reference.float()).abs().max().item()
+
+
+def op_rms_norm(cfg):
+    x = torch.randn(1, cfg.tokens, HIDDEN, device=cfg.device, dtype=cfg.dtype) * 8
+    weight = torch.randn(HIDDEN, device=cfg.device, dtype=cfg.dtype)
+    out = torch.empty_like(x)
+    native = lambda: _infinicore.rms_norm_(wrap(out), wrap(x), wrap(weight), 1e-6)  # noqa: E731
+    reference = lambda: torch.nn.functional.rms_norm(x, (HIDDEN,), weight, eps=1e-6)  # noqa: E731
+    native()
+    return out, reference(), native, reference, None
+
+
+def op_swiglu(cfg):
+    packed = torch.randn(1, cfg.tokens, 2 * FFN, device=cfg.device, dtype=cfg.dtype) * 2
+    up, gate = packed[..., :FFN].contiguous(), packed[..., FFN:].contiguous()
+    out = torch.empty(1, cfg.tokens, FFN, device=cfg.device, dtype=cfg.dtype)
+    native = lambda: _infinicore.swiglu_(wrap(out), wrap(up), wrap(gate))  # noqa: E731
+    reference = lambda: up * torch.nn.functional.silu(gate)  # noqa: E731
+    native()
+    return out, reference(), native, reference, None
+
+
+def op_gemm(cfg):
+    """The DiT's widest projection shape (gate_up), as InfiniCore's linear."""
+    m, n, k = cfg.tokens, 2 * FFN // cfg.shard, HIDDEN
+    a = torch.randn(m, k, device=cfg.device, dtype=cfg.dtype) * 0.05
+    b = torch.randn(n, k, device=cfg.device, dtype=cfg.dtype) * 0.05
+    out = torch.empty(m, n, device=cfg.device, dtype=cfg.dtype)
+    native = lambda: _infinicore.matmul_(wrap(out), wrap(a), wrap(b.t()))  # noqa: E731
+    reference = lambda: a @ b.t()  # noqa: E731
+    native()
+    return out, reference(), native, reference, 2 * m * n * k
+
+
+def op_attention(cfg):
+    heads = cfg.heads
+    q, k, v = (torch.randn(1, cfg.tokens, heads, HEAD_DIM, device=cfg.device, dtype=cfg.dtype)
+               for _ in range(3))
+    out = torch.empty_like(q)
+    scale = HEAD_DIM ** -0.5
+
+    def native():
+        _infinicore.mha_(wrap(out), wrap(q), wrap(k), wrap(v), None, scale, False)
+
+    def reference():
+        return torch.nn.functional.scaled_dot_product_attention(
+            q.permute(0, 2, 1, 3), k.permute(0, 2, 1, 3), v.permute(0, 2, 1, 3),
+            scale=scale).permute(0, 2, 1, 3).contiguous()
+
+    native()
+    return out, reference(), native, reference, 4 * cfg.tokens * cfg.tokens * HEAD_DIM * heads
+
+
+def op_timestep_embedding(cfg):
+    timestep = torch.rand(2, device=cfg.device, dtype=torch.float32) * 1000
+    out = torch.empty(2, TIME_EMBED_DIM, device=cfg.device, dtype=torch.float32)
+    native = lambda: _infinicore.timestep_embedding_(wrap(out), wrap(timestep))  # noqa: E731
+
+    def reference():
+        half = TIME_EMBED_DIM // 2
+        frequencies = torch.exp(
+            -torch.log(torch.tensor(10000.0, device=cfg.device))
+            * torch.arange(half, device=cfg.device, dtype=torch.float32) / half)
+        angles = timestep[:, None] * frequencies[None, :]
+        return torch.cat([torch.cos(angles), torch.sin(angles)], dim=-1)
+
+    native()
+    return out, reference(), native, reference, None
+
+
+def op_embedding(cfg):
+    """Row gather, as the AdaLN modulation and the RoPE table use it."""
+    table = torch.randn(3 * 2, 6 * HIDDEN, device=cfg.device, dtype=cfg.dtype)
+    indices = torch.randint(0, table.shape[0], (cfg.tokens,), device=cfg.device)
+    out = torch.empty(cfg.tokens, table.shape[1], device=cfg.device, dtype=cfg.dtype)
+    native = lambda: _infinicore.embedding_(wrap(out), wrap(indices), wrap(table))  # noqa: E731
+    reference = lambda: table[indices]  # noqa: E731
+    native()
+    return out, reference(), native, reference, None
+
+
+OPERATORS = {
+    "rms_norm": op_rms_norm,
+    "swiglu": op_swiglu,
+    "gemm_gate_up": op_gemm,
+    "attention": op_attention,
+    "timestep_embedding": op_timestep_embedding,
+    "embedding": op_embedding,
+}
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--tokens", type=int, default=8192)
+    parser.add_argument("--heads", type=int, default=14)
+    parser.add_argument("--shard", type=int, default=1,
+                        help="divide the GEMM's N by this (a tensor-parallel shard)")
+    parser.add_argument("--dtype", choices=["bf16", "fp16", "fp32"], default="bf16")
+    parser.add_argument("--device", default="cuda:0")
+    parser.add_argument("--repeats", type=int, default=20)
+    parser.add_argument("--ops", help="comma-separated subset of " + ",".join(OPERATORS))
+    parser.add_argument("--json", type=Path)
+    parser.add_argument("--seed", type=int, default=0)
+    args = parser.parse_args()
+
+    if not torch.cuda.is_available():
+        print("no accelerator visible")
+        return 1
+    torch.manual_seed(args.seed)
+    dtypes = {"bf16": torch.bfloat16, "fp16": torch.float16, "fp32": torch.float32}
+
+    class Config:
+        tokens = args.tokens
+        heads = args.heads
+        shard = args.shard
+        device = args.device
+        dtype = dtypes[args.dtype]
+
+    cfg = Config()
+    device = torch.device(args.device)
+    torch.cuda.set_device(device)
+    infinicore.set_device(infinicore.device(device.type, device.index or 0))
+
+    properties = torch.cuda.get_device_properties(device)
+    environment = {"device": properties.name, "arch": properties.gcnArchName,
+                   "torch": torch.__version__, "hip": getattr(torch.version, "hip", None),
+                   "dtype": args.dtype, "tokens": args.tokens, "heads": args.heads,
+                   "shard": args.shard}
+    print(json.dumps(environment), flush=True)
+    print(f"{'operator':<22} {'infinicore':>11} {'torch':>10} {'ratio':>7} {'match':>7}  note",
+          flush=True)
+
+    results = []
+    for name in (args.ops.split(",") if args.ops else list(OPERATORS)):
+        if name not in OPERATORS:
+            print(f"{name:<22} unknown operator")
+            continue
+        try:
+            with torch.inference_mode():
+                out, reference, native, torch_fn, flops = OPERATORS[name](cfg)
+                same, delta = difference(out, reference)
+                native_ms = timed(native, args.repeats, device)
+                torch_ms = timed(torch_fn, args.repeats, device)
+        except Exception as exc:  # noqa: BLE001
+            print(f"{name:<22} failed: {type(exc).__name__}: {str(exc)[:80]}", flush=True)
+            results.append({"operator": name, "error": f"{type(exc).__name__}: {exc}"})
+            continue
+        note = "" if same else f"max |diff| {delta:.3g}"
+        if flops:
+            note = (note + " " if note else "") + f"{flops / native_ms / 1e9:.1f} TFLOPS"
+        print(f"{name:<22} {native_ms:10.3f}m {torch_ms:9.3f}m {torch_ms / native_ms:6.2f}x "
+              f"{str(same):>7}  {note}", flush=True)
+        results.append({"operator": name, "infinicore_ms": native_ms, "torch_ms": torch_ms,
+                        "ratio": torch_ms / native_ms, "bitwise_equal": same,
+                        "max_abs_difference": delta, "flops": flops})
+    if args.json:
+        args.json.write_text(json.dumps({"environment": environment, "results": results,
+                                         "diagnostic_only": True}, indent=2) + "\n")
+        print(f"wrote {args.json}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/bench_p2p_sdma.py b/tools/bench_p2p_sdma.py
new file mode 100644
index 0000000..524f40c
--- /dev/null
+++ b/tools/bench_p2p_sdma.py
@@ -0,0 +1,156 @@
+#!/usr/bin/env python3
+"""Peer-to-peer copy-engine (SDMA) bandwidth and its interference with compute.
+
+Single process, all visible devices. Measures
+  1. hipMemcpyPeerAsync bandwidth per ordered device pair (one copy at a time);
+  2. an all-to-all pattern (every device sends one block to every peer at once);
+  3. GEMM time on all devices alone, while the copy engines run the all-to-all
+     pattern, so it can be compared with RCCL all-to-all (bench_rccl_interference.py).
+Diagnostic only; not used by the generation path.
+"""
+import argparse
+import ctypes
+import json
+import time
+
+import torch
+
+hip = ctypes.CDLL("libamdhip64.so")
+
+
+def check(status, what):
+    if status != 0:
+        raise RuntimeError(f"{what} failed with HIP error {status}")
+
+
+def enable_peer_access(devices):
+    access = {}
+    for i in devices:
+        check(hip.hipSetDevice(i), "hipSetDevice")
+        for j in devices:
+            if i == j:
+                continue
+            can = ctypes.c_int(0)
+            check(hip.hipDeviceCanAccessPeer(ctypes.byref(can), i, j), "hipDeviceCanAccessPeer")
+            access[f"{i}->{j}"] = bool(can.value)
+            if can.value:
+                status = hip.hipDeviceEnablePeerAccess(j, 0)
+                if status not in (0, 704):  # 704: already enabled
+                    raise RuntimeError(f"hipDeviceEnablePeerAccess({i}->{j}) = {status}")
+    return access
+
+
+def peer_copy(dst, dst_dev, src, src_dev, nbytes, stream):
+    check(hip.hipMemcpyPeerAsync(ctypes.c_void_p(dst.data_ptr()), dst_dev,
+                                 ctypes.c_void_p(src.data_ptr()), src_dev,
+                                 ctypes.c_size_t(nbytes), ctypes.c_void_p(stream.cuda_stream)),
+          "hipMemcpyPeerAsync")
+
+
+def sync_all(devices):
+    for d in devices:
+        torch.cuda.synchronize(d)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--block-mib", default="10,31,100")
+    parser.add_argument("--gemm", default="5728,10752,5376")  # SP4 QKV group shape (M,N,K)
+    parser.add_argument("--output")
+    args = parser.parse_args()
+    devices = list(range(torch.cuda.device_count()))
+    result = {"devices": devices, "peer_access": enable_peer_access(devices)}
+    streams = {d: torch.cuda.Stream(device=d) for d in devices}
+
+    # 1. Pairwise bandwidth.
+    nbytes = 256 << 20
+    bufs = {d: (torch.empty(nbytes, dtype=torch.uint8, device=d),
+                torch.empty(nbytes, dtype=torch.uint8, device=d)) for d in devices}
+    pair = {}
+    for i in devices:
+        for j in devices:
+            if i == j:
+                continue
+            peer_copy(bufs[j][1], j, bufs[i][0], i, nbytes, streams[i])
+            sync_all(devices)
+            start = time.perf_counter()
+            for _ in range(5):
+                peer_copy(bufs[j][1], j, bufs[i][0], i, nbytes, streams[i])
+            sync_all(devices)
+            pair[f"{i}->{j}"] = round(5 * nbytes / (time.perf_counter() - start) / 1e9, 2)
+    result["pair_GBps"] = pair
+    print(json.dumps({"pair_GBps": pair}), flush=True)
+
+    # 2. All-to-all pattern: device i sends block b to every peer j concurrently.
+    def all_to_all(src, dst, block):
+        for i in devices:
+            for j in devices:
+                if i != j:
+                    peer_copy(dst[j][i], j, src[i][j], i, block, streams[i])
+
+    a2a = {}
+    for mib in map(float, args.block_mib.split(",")):
+        block = int(mib * (1 << 20))
+        src = {i: {j: torch.empty(block, dtype=torch.uint8, device=i) for j in devices} for i in devices}
+        dst = {j: {i: torch.empty(block, dtype=torch.uint8, device=j) for i in devices} for j in devices}
+        all_to_all(src, dst, block)
+        sync_all(devices)
+        start = time.perf_counter()
+        for _ in range(5):
+            all_to_all(src, dst, block)
+        sync_all(devices)
+        seconds = (time.perf_counter() - start) / 5
+        a2a[str(mib)] = {"seconds": seconds,
+                         "per_rank_send_GBps": round((len(devices) - 1) * block / seconds / 1e9, 2)}
+        print(json.dumps({"all_to_all_block_MiB": mib, **a2a[str(mib)]}), flush=True)
+        del src, dst
+    result["all_to_all"] = a2a
+
+    # 3. GEMM interference.
+    m, n, k = map(int, args.gemm.split(","))
+    mats = {d: (torch.randn(m, k, device=d, dtype=torch.bfloat16),
+                torch.randn(n, k, device=d, dtype=torch.bfloat16)) for d in devices}
+    gemm_streams = {d: torch.cuda.Stream(device=d) for d in devices}
+
+    def gemms(reps):
+        for d in devices:
+            with torch.cuda.device(d), torch.cuda.stream(gemm_streams[d]):
+                a, b = mats[d]
+                for _ in range(reps):
+                    torch.mm(a, b.t())
+
+    reps = 40
+    gemms(2)
+    sync_all(devices)
+    start = time.perf_counter()
+    gemms(reps)
+    sync_all(devices)
+    alone = (time.perf_counter() - start) / reps
+    block = 31 << 20
+    src = {i: {j: torch.empty(block, dtype=torch.uint8, device=i) for j in devices} for i in devices}
+    dst = {j: {i: torch.empty(block, dtype=torch.uint8, device=j) for i in devices} for j in devices}
+    sync_all(devices)
+    start = time.perf_counter()
+    gemms(reps)
+    for _ in range(12):
+        all_to_all(src, dst, block)
+    sync_all(devices)
+    both = time.perf_counter() - start
+    # Copies alone for the same amount, to see how much overlapped.
+    start = time.perf_counter()
+    for _ in range(12):
+        all_to_all(src, dst, block)
+    sync_all(devices)
+    copies = time.perf_counter() - start
+    flops = 2 * m * n * k
+    result["gemm_interference"] = {
+        "gemm_ms_alone": alone * 1e3, "gemm_TFLOPS_alone": flops / alone / 1e12,
+        "gemms_plus_copies_s": both, "gemms_alone_s": alone * reps, "copies_alone_s": copies}
+    print(json.dumps(result["gemm_interference"]), flush=True)
+    if args.output:
+        with open(args.output, "w") as f:
+            json.dump(result, f, indent=2)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/bench_qk_norm_rope.py b/tools/bench_qk_norm_rope.py
new file mode 100644
index 0000000..f6577d1
--- /dev/null
+++ b/tools/bench_qk_norm_rope.py
@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""Diagnostic: the block-tiled q/k RMSNorm + RoPE NineToothed kernel against the
+one-token-per-program kernel, on the SP4 layout (strided source view of the
+fused QKV projection, permuted send buffer): bitwise check and timing."""
+import sys
+import time
+from pathlib import Path
+
+import torch
+
+sys.path[:0] = [str(Path(__file__).resolve().parents[1] / "ninetoothed/src"), str(Path(__file__).resolve().parent)]
+from h3_pointwise import make_qk_norm_rope  # noqa: E402
+
+T, P, HS, D = 5726, 4, 7, 128
+torch.manual_seed(0)
+dev = "cuda:1"
+projected = torch.randn(T, 3, P * HS, D, device=dev, dtype=torch.bfloat16)
+source = projected[:, 0]                        # [T, P*Hs, D], token stride 3*P*Hs*D
+by_rank = source.as_strided((T, P, HS, D), (source.stride(0), HS * source.stride(1), source.stride(1), 1))
+weight = (torch.rand(D, device=dev) + 0.5).to(torch.bfloat16)
+cos = torch.rand(T, 48, device=dev).to(torch.bfloat16)
+sin = torch.rand(T, 48, device=dev).to(torch.bfloat16)
+
+
+def run(kernel):
+    out = torch.empty(P, T, HS, D, device=dev, dtype=torch.bfloat16)
+    y = out.permute(1, 0, 2, 3)
+    with torch.cuda.device(dev):
+        kernel(by_rank, by_rank, by_rank, weight, weight, weight, 1e-5, cos, sin, y, y, y)
+    return out
+
+
+def bench(kernel):
+    for _ in range(3):
+        run(kernel)
+    torch.cuda.synchronize(dev)
+    start = time.perf_counter()
+    for _ in range(50):
+        run(kernel)
+    torch.cuda.synchronize(dev)
+    return (time.perf_counter() - start) / 50
+
+
+import tempfile
+build = Path(tempfile.mkdtemp(prefix="qk_aot_"))
+arch = torch.cuda.get_device_properties(dev).gcnArchName.split(":")[0]
+
+
+def make(**options):
+    out_dir = build / "_".join(f"{k}{v}" for k, v in options.items())
+    out_dir.mkdir()
+    return make_qk_norm_rope(caller="hip", output_dir=out_dir, archs=[arch], **options)
+
+
+reference = make(block_tokens=1, num_warps=1)
+print("reference built", flush=True)
+expected = run(reference)
+print(f"current (1 token, 1 rank, 1 warp): {bench(reference) * 1e3:.3f} ms", flush=True)
+configs = [tuple(int(v) for v in c.split(",")) for c in sys.argv[1:]] or [(1, 4, 8, 1), (1, 4, 8, 2), (1, 4, 8, 4)]
+for bt, ranks, rows, nw in configs:
+    try:
+        kernel = make(block_tokens=bt, ranks=ranks, rows=rows, num_warps=nw)
+        same = torch.equal(run(kernel), expected)
+        print(f"bt{bt} ranks{ranks} rows{rows} w{nw}: {bench(kernel) * 1e3:.3f} ms bitwise {same}", flush=True)
+    except Exception as exc:  # noqa: BLE001
+        print(f"bt{bt} ranks{ranks} rows{rows} w{nw}: failed {type(exc).__name__}: {str(exc)[:160]}", flush=True)
