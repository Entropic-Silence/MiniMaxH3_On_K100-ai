index 0000000..d3eb713
--- /dev/null
+++ b/tools/pyspy_pipeline_other.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Diagnostic: from a `py-spy record --format raw` profile of the unified
+entry, attribute main-thread samples inside the generation call that are NOT
+inside a timed component (the entry's ComponentProfiler `timed` wrapper) to
+the pipeline block and leaf function they were spent in."""
+import collections
+import re
+import sys
+
+
+def main():
+    path = sys.argv[1]
+    rate = float(sys.argv[2]) if len(sys.argv) > 2 else 25.0
+    blocks = collections.Counter()
+    leaves = collections.Counter()
+    timed = collections.Counter()
+    total = 0
+    warmup = 0
+    with open(path) as handle:
+        for line in handle:
+            line = line.rstrip()
+            if not line:
+                continue
+            stack, _, count = line.rpartition(" ")
+            count = int(count)
+            frames = stack.split(";")
+            if not any(f.startswith("main (") and "minimax_h3.py" in f for f in frames):
+                continue
+            if not any("modular_pipeline.py" in f and f.startswith("__call__") for f in frames):
+                continue
+            if any(f.startswith("warmup_pipeline (") for f in frames):
+                warmup += count  # the load-time warmup generation, not timed
+                continue
+            total += count
+            timed_index = next((i for i, f in enumerate(frames) if f.startswith("timed (")), None)
+            if timed_index is not None:
+                below = frames[timed_index + 1] if timed_index + 1 < len(frames) else "?"
+                timed[re.sub(r":\d+\)", ")", below)] += count
+                continue
+            block = "?"
+            for f in frames:
+                if "modular_pipelines/minimax_h3/" in f and f.startswith("__call__"):
+                    block = re.sub(r":\d+\)", ")", f)
+            blocks[block] += count
+            leaves[frames[-1]] += count
+    other = total - sum(timed.values())
+    print(f"generation samples {total} ({total / rate:.1f} s), timed {sum(timed.values()) / rate:.1f} s, "
+          f"other {other / rate:.1f} s (warmup generation excluded: {warmup / rate:.1f} s)")
+    print("timed components:")
+    for name, count in timed.most_common(8):
+        print(f"  {count / rate:7.2f} s  {name}")
+    print("other, by pipeline block:")
+    for name, count in blocks.most_common(15):
+        print(f"  {count / rate:7.2f} s  {name}")
+    print("other, by leaf frame:")
+    for name, count in leaves.most_common(25):
+        print(f"  {count / rate:7.2f} s  {name}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/trace_pipeline.py b/tools/trace_pipeline.py
new file mode 100644
index 0000000..2a3242f
--- /dev/null
+++ b/tools/trace_pipeline.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Diagnostic: run the unified entry (InfiniLM/examples/minimax_h3.py, loaded
+unchanged) and record a hash of the inputs and outputs of every timed
+component call of the generation (condition encoder, VAE encodes, each DiT
+forward, VAE decodes), one JSON line per call. Two runs of the same command
+can then be compared call by call to find where they first differ
+(tools/compare_traces.py). The hashing synchronizes the devices and copies
+tensors to the host, so timings of a traced run are not representative.
+Never used by generation.
+
+usage: trace_pipeline.py OUT.jsonl <minimax_h3.py arguments...>
+"""
+import functools
+import hashlib
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+import torch
+
+ENTRY = Path(__file__).resolve().parents[1] / "InfiniLM" / "examples" / "minimax_h3.py"
+
+
+def digest(obj, depth=0):
+    if torch.is_tensor(obj):
+        tensor = obj.detach()
+        if tensor.is_cuda:
+            torch.cuda.synchronize(tensor.device)
+        tensor = tensor.contiguous().cpu()
+        if tensor.dtype in (torch.bfloat16, torch.float16):
+            tensor = tensor.view(torch.int16)
+        return f"{list(obj.shape)}:{str(obj.dtype)[6:]}:" + hashlib.sha1(tensor.numpy().tobytes()).hexdigest()[:16]
+    if depth > 3:
+        return None
+    if isinstance(obj, (list, tuple)):
+        return [digest(item, depth + 1) for item in obj]
+    if isinstance(obj, dict):
+        return {str(key): digest(value, depth + 1) for key, value in obj.items()}
+    if hasattr(obj, "__dict__") and not isinstance(obj, torch.nn.Module):
+        found = {name: digest(value, depth + 1) for name, value in vars(obj).items()
+                 if torch.is_tensor(value) or hasattr(value, "__dict__") or isinstance(value, (list, tuple, dict))}
+        return {name: value for name, value in found.items() if value not in (None, [], {})} or None
+    return None
+
+
+def main():
+    out_path = Path(sys.argv[1])
+    sys.argv = [str(ENTRY)] + sys.argv[2:]
+    spec = importlib.util.spec_from_file_location("h3_entry", ENTRY)
+    entry = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = entry  # dataclasses look their module up there
+    spec.loader.exec_module(entry)
+    out = out_path.open("w")
+    counts = {}
+
+    def wrap(owner, method_name, name):
+        original = getattr(owner, method_name)
+
+        @functools.wraps(original)
+        def traced(*args, **kwargs):
+            result = original(*args, **kwargs)
+            index = counts.get(name, 0)
+            counts[name] = index + 1
+            record = {"call": name, "index": index, "args": digest(list(args)),
+                      "kwargs": digest(kwargs), "output": digest(result)}
+            out.write(json.dumps(record) + "\n")
+            out.flush()
+            return result
+
+        setattr(owner, method_name, traced)
+
+    install = entry.install_component_profilers
+
+    def install_traced(report, *, text_encoder, transformer, vae, audio_vae):
+        profiler = install(report, text_encoder=text_encoder, transformer=transformer,
+                           vae=vae, audio_vae=audio_vae)
+        wrap(text_encoder.model, "forward", "condition_encoder")
+        wrap(transformer, "forward", "transformer")
+        wrap(vae, "encode", "video_vae_encode")
+        wrap(audio_vae, "encode", "audio_vae_encode")
+        wrap(vae, "decode", "video_vae_decode")
+        wrap(audio_vae, "decode", "audio_vae_decode")
+        return profiler
+
+    entry.install_component_profilers = install_traced
+    try:
+        entry.main()
+    finally:
+        out.close()
+
+
+if __name__ == "__main__":
+    main()
